# Theme files: browsers keep them for a long time. Every page asks for CSS and JS with ?v=<deploy version>,
# so a deploy always fetches the new files. Fonts, icons and images change name or version when they change.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(php|json|html|txt|md)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nothing in the theme folder is a page: no directory listings, no direct access to the content files
Options -Indexes
<FilesMatch "\.(json|md|txt)$">
  Require all denied
</FilesMatch>
